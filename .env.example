# ============================================================
# Perpustakaan Jendela Ilmu - Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control!
# ============================================================

# ===== Database =====
# SQLite for development. Use PostgreSQL in production.
DATABASE_URL="file:./db/dev.db"

# ===== Authentication =====
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE-ME-generate-with-openssl-rand-base64-32"

# Cron job authentication
CRON_SECRET="CHANGE-ME-cron-secret"

# ===== App =====
# Public URL for emails, redirects, etc
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Perpustakaan Jendela Ilmu"

# WebSocket server (Sprint F2)
WS_PORT="3003"
WS_WEBHOOK_SECRET="CHANGE-ME-ws-webhook-secret"

# ===== AI Services (Sprint F1) =====
# Provider: openai | anthropic | google | mock
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

# ===== Push Notifications (PWA) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===== Email (Production only) =====
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@jendelailmu.sch.id"

# ===== WhatsApp (Production only) =====
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_FROM=""

# ===== Analytics =====
# Optional: Google Analytics
NEXT_PUBLIC_GA_ID=""

# Optional: Sentry for error tracking
SENTRY_DSN=""

# ===== Feature Flags =====
ENABLE_AI_CHAT="true"
ENABLE_BLOCKCHAIN_AUDIT="true"
ENABLE_RFID="true"
ENABLE_NATIVE_MOBILE="true"

# ===== Performance =====
# Force HTTPS in production
FORCE_HTTPS="false"

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"
