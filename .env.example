# Database
# SQLite untuk development, PostgreSQL untuk production
DATABASE_URL="file:./db/custom.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth (WAJIB — GANTI untuk production!)
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
CSRF_SECRET="ganti-dengan-string-acak-atau-samakan-dengan-JWT_SECRET"

# App URL (WAJIB untuk email links & WhatsApp)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXTAUTH_URL="https://your-domain.com"

# Proxy (Render/Vercel reverse proxy)
TRUST_PROXY="true"

# WebSocket (untuk real-time features)
WS_WEBHOOK_SECRET="ganti-dengan-string-acak"
WS_PORT="3003"

# Email — Gmail SMTP (optional)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# WhatsApp — Fonnte Gateway (optional)
FONNTE_TOKEN=""

# AI Chat Assistant (optional)
AI_API_KEY=""
AI_PROVIDER=""
# AI_MODEL="gpt-4o-mini"

# Push Notifications — VAPID (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.com"

# Voice Webhooks (optional)
VOICE_WEBHOOK_SECRET=""

# Sentry Error Tracking (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Logging
LOG_LEVEL="info"

# Upload
UPLOAD_DIR="./public/uploads"
