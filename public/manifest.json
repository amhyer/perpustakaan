  "screenshots": [
    {
      "src": "/screenshots/dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard utama dengan katalog buku"
    },
    {
      "src": "/screenshots/mobile-home.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Beranda siswa di mobile"
    }
  ],

  "shortcuts": [
    {
      "name": "Katalog Buku",
      "short_name": "Katalog",
      "description": "Cari buku di katalog",
      "url": "/?view=catalog",
      "icons": [
        { "src": "/icons/shortcut-catalog.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Pinjaman Saya",
      "short_name": "Pinjaman",
      "description": "Lihat pinjaman aktif",
      "url": "/?view=my-loans",
      "icons": [
        { "src": "/icons/shortcut-loans.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Kartu Anggota",
      "short_name": "Kartu",
      "description": "Tampilkan kartu anggota digital",
      "url": "/?view=my-card",
      "icons": [
        { "src": "/icons/shortcut-card.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Scan Barcode",
      "short_name": "Scan",
      "description": "Scan ISBN buku",
      "url": "/?view=scanner",
      "icons": [
        { "src": "/icons/shortcut-scan.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Cari dengan AI",
      "short_name": "AI Search",
      "description": "Cari buku dengan bahasa natural",
      "url": "/?view=ai-search",
      "icons": [
        { "src": "/icons/shortcut-ai.png", "sizes": "96x96", "type": "image/png" }
      ]
    }
  ],

  "categories": ["education", "books", "productivity"],

  "share_target": {
    "action": "share-to-jendela-ilmu",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "edge_side_panel": {
    "preferred_width": 480
  },

  "launch_handler": {
    "client_mode": "auto"
  },

  "protocol_handlers": [
    {
      "protocol": "web+jendelailmu",
      "url": "/book?isbn=%s"
    }
  ]
}
