{
  "name": "perpustakaan-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Perpustakaan Jendela Ilmu - Native Mobile App (React Native)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace Perpustakaan.xcworkspace -scheme Perpustakaan -configuration Release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-camera/camera": "^3.43.0",
    "@react-native-community/netinfo": "^11.3.2",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/messaging": "^21.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.0",
    "date-fns": "^4.1.0",
    "i18n-js": "^4.5.0",
    "lucide-react-native": "^0.460.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "^2.21.0",
    "react-native-image-picker": "^7.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.3.0",
    "react-native-permissions": "^5.2.0",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-reanimated": "^3.16.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "^15.10.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.12.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.76.0",
    "@react-native/eslint-config": "0.76.0",
    "@react-native/metro-config": "0.76.0",
    "@react-native/typescript-config": "0.76.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
