// Perpustakaan Jendela Ilmu - Database Schema
// Inspired by SLiMS (Senayan Library Management System)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookSource {
  MANUAL
  SIBI
}

// ===== Users & Auth =====
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STUDENT") // LIBRARIAN | TEACHER | STUDENT
  member       Member?
  preference   UserPreference?
  announcements Announcement[]
  proposals     BookProposal[]     @relation("ProposalReviewer")
  notifications Notification[]
  auditLogs    AuditLog[]
  transfers    BookTransfer[]
  twoFactor     TwoFactorSecret?
  passwordResetTokens PasswordResetToken[]
  activeSessions     ActiveSession[]
  // Reward System relations
  pointTransactionsAwarded PointTransaction[] @relation("PointAdjuster")
  rewardsCreated           Reward[]            @relation("RewardCreator")
  redemptionsApproved      RewardRedemption[]  @relation("RewardApprover")
  redemptionsDelivered     RewardRedemption[]  @relation("RewardDeliverer")
  // Push notification
  pushSubscriptions        PushSubscription[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== User Preferences (Sprint 4 — Fix #9) =====
// Preferensi per-user, terpisah dari Setting global (yang dipakai semua user).
// Saat ini menyimpan 'defaultDashboard' — view pertama saat user login.
// LIBRARIAN/PUSTAKAWAN_JUNIOR: 'dashboard' | 'customizable-dashboard' | 'executive-dashboard'
// TEACHER/STUDENT: 'my-dashboard' (saat ini hanya 1 opsi)
model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultDashboard String   @default("default") // 'default' = pakai auto-route berdasar role
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== Members =====
model Member {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNumber String   @unique // Nomor Anggota Perpustakaan
  fullName     String
  category     String   @default("STUDENT") // LIBRARIAN | TEACHER | STUDENT
  status       String   @default("ACTIVE")  // ACTIVE | INACTIVE
  gender       String?  // L | P
  birthDate    DateTime?
  phone        String?
  address      String?
  photo        String?  // URL or base64
  classGrade   String?  // untuk siswa: kelas, untuk guru: mata pelajaran
  joinDate     DateTime @default(now())
  expiryDate   DateTime?
  // Gamifikasi (Tahap 8A) — target baca tahunan
  readingGoalTarget Int?
  readingGoalSetAt  DateTime?
  loans        Loan[]
  reservations Reservation[]
  wishlists    Wishlist[]
  proposals    BookProposal[]
  reviews      BookReview[]
  roomBookings RoomBooking[]
  visitors     Visitor[]
  assetLoans   AssetLoan[]
  // Reward System relations
  pointTransactions PointTransaction[]
  redemptions       RewardRedemption[]
  recommendations   Recommendation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, status])
  @@index([status, expiryDate])
  @@index([joinDate])
}

// ===== Categories (GMD / Klasifikasi) =====
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique // kode klasifikasi mirip Dewey sederhana
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
}

// ===== Locations / Rak =====
model Location {
  id              String   @id @default(cuid())
  name            String   @unique // mis. "Rak A - Fiksi"
  code            String   @unique // mis. "A-01"
  description     String?
  books           Book[]
  transfersFrom   BookTransfer[] @relation("FromLocation")
  transfersTo     BookTransfer[] @relation("ToLocation")
  assets          Asset[]
  createdAt       DateTime @default(now())
}

// ===== Books (Bibliografi) =====
model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  publisher   String?
  isbn        String?
  year        Int?
  pages       Int?
  synopsis    String?
  coverImage  String?  // URL gambar cover
  coverColor  String   @default("#1e3a5f") // warna gradient untuk cover placeholder
  language    String   @default("Indonesia")
  subject     String?  // mata pelajaran / subjek
  source      BookSource @default(MANUAL) // MANUAL | SIBI
  sourceUrl   String?  // tautan file digital asal (mis. PDF SIBI)
  sibiId      String?  @unique // id dari SIBI, null kalau source=MANUAL
  importedAt  DateTime? // waktu impor dari SIBI, null kalau source=MANUAL
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  items       BookItem[]
  recommendations Recommendation[]
  reservations Reservation[]
  wishlists   Wishlist[]
  attachments BookAttachment[]
  reviews     BookReview[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([locationId])
  @@index([sibiId])
}

// ===== Book Items (Eksemplar) =====
model BookItem {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  itemCode    String   @unique // kode barcode unik per eksemplar
  status      String   @default("AVAILABLE") // AVAILABLE | BORROWED | DAMAGED | LOST | RESERVED
  condition   String   @default("BAIK") // BAIK | RUSAK_RINGAN | RUSAK_BERAT
  loans       Loan[]
  stocktakingScans StocktakingScan[]
  conditionLogs ConditionLog[]
  transfers   BookTransfer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookId])
  @@index([status])
}

// ===== Condition Log (Riwayat Kondisi Eksemplar) =====
model ConditionLog {
  id               String    @id @default(cuid())
  bookItemId       String
  bookItem         BookItem  @relation(fields: [bookItemId], references: [id], onDelete: Cascade)
  previousCondition String?
  newCondition     String
  previousStatus   String?
  newStatus        String?
  reason           String?
  reportedById     String    // userId of the librarian
  loanId           String?   // linked to active loan if relevant
  createdAt        DateTime  @default(now())

  @@index([bookItemId])
  @@index([loanId])
}

// ===== Loans (Sirkulasi) =====
model Loan {
  id           String    @id @default(cuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id])
  bookItemId   String
  bookItem     BookItem  @relation(fields: [bookItemId], references: [id])
  bookId       String    // denormalized for easy queries
  loanDate     DateTime  @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  status       String    @default("LOANED") // LOANED | RETURNED | OVERDUE
  fineAmount   Int       @default(0) // dalam Rupiah
  finePaid     Int       @default(0)
  renewedCount Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([loanDate])
  @@index([returnDate])
  @@index([bookItemId])
}

// ===== Reservations / Booking =====
model Reservation {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id])
  status      String   @default("PENDING") // PENDING | READY | FULFILLED | CANCELLED | EXPIRED
  queueOrder  Int      @default(1)
  reservedAt  DateTime @default(now())
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId])
  @@index([bookId])
  @@index([status])
}

// ===== Wishlist / Favorit =====
model Wishlist {
  id                String   @id @default(cuid())
  memberId          String
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookId            String
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  notifiedAvailable Boolean  @default(false) // sudah dinotifikasi tersedia (Tahap 15)

  @@unique([memberId, bookId])
}

// ===== Book Proposals (Usulan Koleksi) =====
model BookProposal {
  id           String    @id @default(cuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id])
  title        String
  author       String?
  publisher    String?
  isbn         String?
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy   String?
  reviewer     User?     @relation("ProposalReviewer", fields: [reviewedBy], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// ===== Announcements / Pengumuman =====
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPinned, publishedAt])
  @@index([publishedAt])
}

// ===== Notifications =====
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | WARNING | DUE_DATE | OVERDUE | ANNOUNCEMENT
  isRead    Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ===== Settings (aturan perpustakaan) =====
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ===== Library Holidays (Hari Libur) — Tahap 15-B =====
// Tanggal spesifik yang didaftarkan pustakawan sebagai hari libur.
// Hanya tanggal di sini yang dianggap libur — TIDAK otomatis meniadakan
// akhir pekan (Sabtu/Minggu), karena jam operasional tiap sekolah bisa beda.
// Dipakai di perhitungan dueDate: kalau jatuh tempo jatuh di salah satu
// tanggal ini, geser maju ke hari berikutnya yang bukan hari libur.
model LibraryHoliday {
  id          String   @id @default(cuid())
  date        DateTime @unique // tanggal libur (tanpa jam, pakai awal hari)
  description String
  createdAt   DateTime @default(now())

  @@index([date])
}

// ===== Master Publisher & Author — Tahap 15-C =====
// Sumber saran autocomplete untuk form buku. Field publisher/author di Book
// TETAP teks bebas (bukan foreign key wajib) — supaya tidak ada risiko
// migrasi data. Tabel ini hanya sebagai daftar nilai unik untuk autocomplete.
// Saat buku disimpan dengan nama penerbit/pengarang baru, otomatis ditambahkan
// ke master tabel ini (upsert by name).
model Publisher {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Author {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ===== Book Attachments (Lampiran Digital) — Tahap 15-D =====
// File digital terlampir per buku (PDF, gambar, audio — TANPA video).
// Reuse UPLOAD_DIR infrastruktur. Batas 15MB per file, disk Render 1GB.
model BookAttachment {
  id             String   @id @default(cuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fileName       String   // nama file asli saat di-upload
  fileUrl        String   // path relatif untuk akses (mis. /uploads/attachments/xxx.pdf)
  fileType       String   // MIME type (application/pdf, image/jpeg, audio/mpeg)
  fileSizeBytes  Int
  uploadedAt     DateTime @default(now())

  @@index([bookId])
}

// ===== Stock Opname (Urutan 11 — Tahap 15-A) =====
model StocktakingSession {
  id            String             @id @default(cuid())
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  note          String?
  status        String             @default("ONGOING") // ONGOING | COMPLETED
  createdById   String
  expectedCount Int
  scans         StocktakingScan[]
}

model StocktakingScan {
  id         String            @id @default(cuid())
  sessionId  String
  session    StocktakingSession @relation(fields: [sessionId], references: [id])
  bookItemId String
  bookItem   BookItem          @relation(fields: [bookItemId], references: [id])
  scannedAt  DateTime          @default(now())

  @@unique([sessionId, bookItemId])
  @@index([sessionId])
  @@index([bookItemId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model BookReview {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  rating    Int      // 1-5
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, bookId])
  @@index([bookId])
}

model BookTransfer {
  id              String   @id @default(cuid())
  bookItemId      String
  bookItem        BookItem @relation(fields: [bookItemId], references: [id])
  fromLocationId  String?
  fromLocation    Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      Location @relation("ToLocation", fields: [toLocationId], references: [id])
  reason          String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())

  @@index([bookItemId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([userId])
  @@index([createdAt])
}

// ===== Two-Factor Authentication (Tahap 17 - Critical Fix) =====
model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String   // TOTP secret (base32)
  enabled     Boolean  @default(false)
  backupCodes String?  // JSON array of hashed backup codes
  createdAt   DateTime @default(now())
  enabledAt   DateTime?
}

// ===== Password Reset Token (Tahap 17 - Critical Fix) =====
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // hashed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ===== Active Session (Tahap 17 - Critical Fix) =====
// Track active sessions per user untuk fitur "force logout" & session management.
model ActiveSession {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique // hashed session token
  userAgent  String?
  ip         String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ===== Library Room (Tahap 18 - Operasional) =====
model LibraryRoom {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // READING | DISCUSSION | AV | COMPUTER | OTHER
  capacity    Int
  description String?
  isActive    Boolean  @default(true)
  bookings    RoomBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoomBooking {
  id        String   @id @default(cuid())
  roomId    String
  room      LibraryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id])
  bookerName String  // untuk walk-in / non-member
  bookerPhone String?
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    String   @default("BOOKED") // BOOKED | CHECKED_IN | COMPLETED | CANCELLED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([startTime, endTime])
  @@index([memberId])
}

// ===== Visitor / Buku Tamu (Tahap 19 - Pelayanan) =====
model Visitor {
  id         String   @id @default(cuid())
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id])
  name       String   // nama untuk non-member
  purpose    String?  // baca, pinjam, diskusi, tugas, dll
  checkIn    DateTime @default(now())
  checkOut   DateTime?
  notes      String?

  @@index([memberId])
  @@index([checkIn])
}

// ===== Asset (Tahap 20 - Operasional) =====
// Aset non-buku: proyektor, laptop, mikrofon, dll.
model Asset {
  id            String   @id @default(cuid())
  name          String
  category      String   // AV | IT | FURNITURE | OTHER
  serialNumber  String?  @unique
  brand         String?
  model         String?
  condition     String   @default("BAIK") // BAIK | RUSAK_RINGAN | RUSAK_BERAT
  status        String   @default("AVAILABLE") // AVAILABLE | BORROWED | MAINTENANCE | LOST
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id])
  notes         String?
  loans         AssetLoan[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model AssetLoan {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])
  loanDate   DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("LOANED") // LOANED | RETURNED | OVERDUE
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([assetId])
  @@index([memberId])
  @@index([status])
}

// ===== Email Log (Tahap 21 - Komunikasi) =====
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  body       String
  category   String   // REMINDER | OVERDUE | ANNOUNCEMENT | WELCOME | RESET_PASSWORD | OTHER
  status     String   @default("PENDING") // PENDING | SENT | FAILED
  errorMsg   String?
  sentAt     DateTime?
  relatedId  String?  // e.g. loan id, announcement id
  createdAt  DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
}

// ===== WhatsApp Log (Tahap 21 - Komunikasi) =====
model WhatsAppLog {
  id         String   @id @default(cuid())
  phone      String
  message    String
  category   String   // REMINDER | OVERDUE | ANNOUNCEMENT | WELCOME | RESET_PASSWORD | OTHER
  status     String   @default("PENDING") // PENDING | SENT | FAILED
  errorMsg   String?
  sentAt     DateTime?
  relatedId  String?
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
}

// ===== API Key (Tahap 22 - Integrasi) =====
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique // hashed API key
  prefix      String   // first 8 chars (unhashed) for display
  scopes      String   // JSON array of scopes: ["read:books", "write:loans", ...]
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())

  @@index([keyHash])
  @@index([isActive])
}

// ===== Audit Log Archive (Tahap 17 - retention policy) =====
model AuditLogArchive {
  id         String   @id
  userId     String
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ===== Error Log (Tahap 17 - Error Tracking) =====
model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  level      String   @default("ERROR") // DEBUG | INFO | WARN | ERROR | FATAL
  userId     String?
  url        String?
  method     String?
  statusCode Int?
  userAgent  String?
  ip         String?
  context    String?  // JSON
  resolved   Boolean  @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([userId])
  @@index([createdAt])
  @@index([resolved])
}

// =========================================================================
// REWARD SYSTEM — Sistem Poin & Hadiah untuk Siswa/Guru
// =========================================================================

/// Aturan poin yang bisa dikonfigurasi pustakawan.
/// Setiap event (loan returned, review, badge earned) memicu rule ini.
model PointRule {
  id          String   @id @default(cuid())

  // Identifikasi rule
  code        String   @unique // LOAN_RETURNED, STREAK_7, REVIEW_5STAR, dll
  name        String
  description String?

  // Konfigurasi poin
  points      Int      // 10 poin per trigger
  role        String   @default("STUDENT") // STUDENT | TEACHER | BOTH

  // Pembatasan
  isActive    Boolean  @default(true)
  maxPerDay   Int?     // null = unlimited
  maxPerMonth Int?     // null = unlimited
  cooldownHours Int?   // null = no cooldown

  // Periode aktif (untuk event khusus, misal "Marathon Juni")
  validFrom   DateTime?
  validUntil  DateTime?

  // Anti-cheat: minimal durasi baca & halaman
  minLoanDays    Int?  // null = no min, mis. 2 (tidak dapat poin kalau pinjam <2 hari)
  minBookPages   Int?  // null = no min, mis. 50 (buku tipis tidak dapat poin)
  requireReview  Boolean @default(false) // Harus tulis review untuk dapat poin

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions PointTransaction[]

  @@index([code, isActive])
  @@index([role, isActive])
}

/// Buku besar (ledger) semua transaksi poin.
/// Setiap perubahan poin (masuk/keluar) di-log untuk audit & transparansi.
model PointTransaction {
  id          String   @id @default(cuid())

  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Tipe transaksi
  type        String   // EARN | REDEEM | ADJUST_UP | ADJUST_DOWN | EXPIRE

  // Sumber (untuk EARN)
  source      String?  // LOAN_RETURNED | STREAK | REVIEW | RATING | BADGE | MANUAL | EARLY_RETURN | ON_TIME_RETURN
  sourceId    String?  // ID dari Loan/Review/Badge (opsional)

  // Rule config yang trigger
  pointsConfigId String?
  pointsConfig   PointRule? @relation(fields: [pointsConfigId], references: [id])

  // Nominal
  amount      Int      // +50 (earn) atau -200 (redeem). Selalu positif.
  balanceAfter Int     // snapshot saldo setelah transaksi (running balance)

  // Untuk REDEEM — link ke Reward & Redemption
  rewardId    String?
  reward      Reward?  @relation(fields: [rewardId], references: [id])
  redemptionId String?
  redemption  RewardRedemption? @relation(fields: [redemptionId], references: [id])

  // Metadata
  description String?  // "Selesai baca 'Laskar Pelangi'"

  // Untuk MANUAL: pustakawan yang kasih
  awardedById String?
  awardedBy   User?    @relation("PointAdjuster", fields: [awardedById], references: [id])

  // Untuk EXPIRE: tanggal poin tsb jadi invalid
  expiresAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([type, createdAt])
  @@index([source, sourceId])
  @@index([redemptionId])
  @@index([expiresAt])
}

/// Katalog hadiah yang dikelola pustakawan.
/// Siswa/guru klaim dari sini, pustakawan approve & serahkan.
model Reward {
  id          String   @id @default(cuid())

  // Info dasar
  name        String
  description String?
  imageUrl    String?  // Foto hadiah (upload atau URL)
  category    String   // BOOK | STATIONERY | VOUCHER | GIFT_CARD | PRIVILEGE | CERTIFICATE | CUSTOM

  // Biaya & syarat
  pointCost   Int      // 200 poin
  minRole     String   @default("STUDENT") // STUDENT | TEACHER (siapa yang boleh)

  // Stok
  stock       Int?     // null = unlimited
  stockClaimed Int     @default(0)

  // Aturan klaim
  requiresApproval Boolean @default(false) // Hadiah mahal perlu approval pustakawan
  maxPerMember     Int?    // null = unlimited, atau max klaim per siswa
  cooldownDays     Int?    // null = no cooldown, atau min jarak antar klaim

  // Tampilan
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false) // Tampil di "Highlighted"
  sortOrder   Int      @default(0)     // Urutan tampil (asc)

  // Audit
  createdById String
  createdBy   User     @relation("RewardCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  redemptions RewardRedemption[]
  transactions PointTransaction[]

  @@index([isActive, isFeatured])
  @@index([isActive, sortOrder])
  @@index([category])
  @@index([minRole, isActive])
}

/// Histori klaim hadiah oleh member.
/// Flow: PENDING → APPROVED → DELIVERED (atau CANCELLED/REJECTED).
model RewardRedemption {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id])

  // Snapshot (untuk audit, kalau hadiah diedit/hapus history tetap valid)
  rewardName  String
  rewardCategory String
  pointsSpent Int

  // Status flow
  status      String   @default("PENDING")
  // PENDING → APPROVED → DELIVERED (happy path)
  // PENDING → REJECTED (pustakawan tolak, poin di-refund)
  // PENDING | APPROVED → CANCELLED (siswa batalkan sebelum disetujui)

  // Approval
  approvedById String?
  approvedBy   User?    @relation("RewardApprover", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  rejectionReason String?

  // Pengambilan
  pickupCode  String   @unique @default(cuid()) // Kode untuk scan saat ambil
  deliveredAt DateTime?
  deliveredById String?
  deliveredBy   User?    @relation("RewardDeliverer", fields: [deliveredById], references: [id])
  deliveryNotes String?

  // Catatan
  memberNote  String?  // Catatan dari siswa saat klaim (misal ukuran, warna)
  staffNote   String?  // Catatan internal pustakawan

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions PointTransaction[]

  @@index([memberId, status])
  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([rewardId])
  @@index([pickupCode])
  @@index([approvedById])
}

/// =========================================================================
/// SEMESTER ARCHIVE — Snapshot leaderboard per periode akademik
/// =========================================================================
///
/// Setiap akhir semester (Ganjil ~Januari, Genap ~Juli), sistem akan
/// snapshot top 100 members dengan saldo poin mereka. Ini jadi:
/// - "Top Reader of the Semester" — historical record
/// - Reset saldo untuk semester baru (opsional, configurable)
/// - Bukti prestasi untuk rapor / sertifikat
///
/// Reset policy (configurable via Setting table):
/// - "leaderboard_reset_mode" = "ARCHIVE" (default) — saldo tetap, archive dibuat
/// - "leaderboard_reset_mode" = "RESET" — saldo di-reset ke 0 setelah archive
/// - "leaderboard_reset_mode" = "CARRYOVER" — saldo tetap, no archive (legacy)
model SemesterArchive {
  id            String   @id @default(cuid())

  // Identifikasi periode
  periodName    String   // "Ganjil 2025/2026" atau "Genap 2025/2026"
  periodType    String   // "ODD" (Ganjil) | "EVEN" (Genap) | "CUSTOM"
  startDate     DateTime
  endDate       DateTime

  // Hasil ranking (snapshot, immutable)
  // Format JSON: [{ rank, memberId, memberName, memberNumber, totalPoints, booksRead }]
  rankings      String   // JSON array

  // Metadata
  totalMembers  Int      // Berapa member yang ikut ranking
  totalPoints   Int      // Total poin beredar di periode ini
  archivedAt    DateTime @default(now())
  archivedBy    String   // "auto-cron" | "manual:<userId>"

  // Audit
  createdAt     DateTime @default(now())

  @@index([periodType, startDate])
  @@index([archivedAt])
  @@unique([periodName, periodType])
}

/// =========================================================================
/// PUSH SUBSCRIPTION — Web Push API subscriptions
/// =========================================================================
///
/// Setiap user yang opt-in untuk push notification punya record di sini.
/// Saat ada event (loan overdue, klaim disetujui, dll), server kirim
/// push via web-push library ke semua subscription yang match.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Subscription details (dari Push API)
  endpoint  String   @unique
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  keys      String   // JSON string of p256dh + auth keys

  // Device info
  userAgent String?

  // Status
  isActive  Boolean  @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([isActive])
}

/// =========================================================================
/// EXPERIMENT ASSIGNMENT — A/B testing untuk reward catalog
/// =========================================================================
///
/// Setiap user di-assign ke satu variant ("control" atau "treatment") untuk
/// experiment tertentu. Berguna untuk testing catalog baru, copy, dll.
model ExperimentAssignment {
  id            String   @id @default(cuid())

  // Identifikasi experiment
  experimentKey String   // "reward_catalog_v2", "point_multiplier_oct"
  variant       String   // "control" | "treatment_a" | "treatment_b"

  // Subject
  memberId      String?
  userId        String?
  classGrade    String?  // untuk cluster experiment by kelas

  // Metadata
  assignedAt    DateTime @default(now())
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  metadata      String?  // JSON additional data

  @@unique([experimentKey, memberId])
  @@index([experimentKey, variant])
  @@index([memberId])
}

/// =========================================================================
/// RECOMMENDATION — ML-based book recommendations
/// =========================================================================
///
/// Cache rekomendasi per-member. Dihitung via collaborative filtering
/// sederhana: "member A dan B sama-sama pinjam buku X, jadi B mungkin
/// tertarik buku Y yang dipinjam A".
///
/// Re-compute setiap 6 jam via cron.
model Recommendation {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Recommendation result
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  score     Float    // 0-1, higher = more recommended
  reason    String   // "Karena kamu sering pinjam fiksi", "Trending di kelasmu"

  rank      Int      // 1-N, top N recommendations
  generatedAt DateTime @default(now())

  @@unique([memberId, bookId])
  @@index([memberId, rank])
}

/// =========================================================================
/// NOTIFICATION SCHEDULE — Notifikasi berkala (digest) yang dijadwalkan
/// =========================================================================
///
/// Untuk mengirim digest mingguan / bulanan ke siswa via WhatsApp/email.
/// Disimpan sebagai record supaya bisa di-track statusnya.
model NotificationSchedule {
  id            String   @id @default(cuid())

  // Schedule metadata
  name          String   // "Weekly Digest", "Monthly Summary", dll
  type          String   // "WEEKLY" | "MONTHLY" | "CUSTOM"
  channel       String   // "EMAIL" | "WHATSAPP" | "BOTH"
  targetRole    String   // "STUDENT" | "TEACHER" | "ALL"

  // Schedule
  dayOfWeek     Int?     // 0-6 (Sunday-Saturday) for WEEKLY
  dayOfMonth    Int?     // 1-31 for MONTHLY
  hour          Int      @default(8)  // 0-23

  // Template
  templateKey   String   // Key di whatsappTemplates / emailTemplates
  enabled       Boolean  @default(true)

  // Last run
  lastRunAt     DateTime?
  lastRunStatus String?  // "success" | "partial" | "failed"
  lastRunCount  Int?     // Berapa orang dikirimi

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, type])
}

// =========================================================================
// AI CHAT ASSISTANT — Customer service chatbot untuk siswa/guru
// =========================================================================
//
// Conversation = sesi chat per user (multiple session allowed)
// Message = individual message dalam conversation (user atau assistant)
// Intent = klasifikasi pertanyaan untuk routing & analytics
//
// Fitur:
// - Multi-turn conversation dengan memory
// - Intent detection (cari buku, cek pinjaman, info poin, dll)
// - Personal context (loan history, point balance, recommendations)
// - Rate limiting per user (default 20 msg/jam)
// - Escalation ke pustakawan jika confidence rendah
// - Cached responses untuk pertanyaan yang sering ditanya (FAQ)

/// Sesi percakapan antara user dan AI assistant.
/// 1 user bisa punya banyak conversation (history).
model ChatConversation {
  id          String        @id @default(cuid())

  // User
  userId      String
  // Optional: link ke member (kalau user adalah student/teacher)
  memberId    String?

  // Metadata sesi
  title       String        // "Cari buku novel" (auto-generated dari pesan pertama)
  channel     String        @default("WEB") // WEB | MOBILE | KIOSK
  locale      String        @default("id")  // "id" | "en" | "ar"

  // Status
  isActive    Boolean       @default(true)
  escalated   Boolean       @default(false) // Di-escalate ke pustakawan?
  escalatedAt DateTime?
  closedAt    DateTime?

  // Statistik
  messageCount Int          @default(0)
  userRating   Int?         // 1-5, feedback dari user
  userFeedback String?      // Komentar feedback

  // Token tracking (untuk cost monitoring)
  totalTokens  Int          @default(0)

  // Relations
  messages     ChatMessage[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([memberId, createdAt])
  @@index([isActive, updatedAt])
  @@index([escalated])
}

/// Individual message dalam conversation.
/// "user" = pesan dari user, "assistant" = balasan AI, "system" = system prompt,
/// "tool" = hasil function call (untuk advanced usage).
model ChatMessage {
  id              String          @id @default(cuid())

  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Isi
  role            String          // "user" | "assistant" | "system" | "tool"
  content         String

  // Intent classification (untuk assistant messages)
  intent          String?         // "book_search" | "loan_status" | "points_info" | "faq" | "general"
  confidence      Float?          // 0-1, hasil classification

  // AI metadata
  provider        String?         // "openai" | "anthropic" | "google" | "mock"
  model           String?         // "gpt-4o-mini" | "claude-3-5-haiku" | "gemini-1.5-flash"
  tokens          Int?            // Total tokens used
  latencyMs       Int?            // Response time

  // Cited sources (untuk RAG)
  sources         String?         // JSON array of {bookId, bookTitle, score}
  suggestedActions String?        // JSON array of {action, label, params}

  // Feedback
  isHelpful       Boolean?        // User feedback (thumbs up/down)
  feedbackNote    String?

  createdAt       DateTime        @default(now())

  @@index([conversationId, createdAt])
  @@index([intent])
  @@index([role])
}

/// FAQ cache — untuk pertanyaan yang sering ditanya.
/// Cached response supaya hemat token & lebih cepat.
model ChatFAQ {
  id          String   @id @default(cuid())

  // Pertanyaan & jawaban
  question    String   @unique // Pattern / exact question
  answer      String   // Response template
  category    String   // "hours" | "membership" | "loan_rules" | "points" | "general"
  locale      String   @default("id")

  // Tracking
  hitCount    Int      @default(0)
  lastHitAt   DateTime?
  isActive    Boolean  @default(true)

  // Variasi pertanyaan (JSON array of alternative phrasings)
  variations  String?  // ["kapan buka", "jam berapa", "jam operasional"]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isActive])
  @@index([locale, isActive])
}
